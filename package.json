{
  "name": "notedude2",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "HEADED=1 playwright test",
    "test:firebase": "FIREBASE_ROUNDTRIP=true playwright test",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:staging": "npm run build && firebase hosting:channel:deploy staging --expires 30d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appsciences/notedude2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/appsciences/notedude2/issues"
  },
  "homepage": "https://github.com/appsciences/notedude2#readme",
  "description": "",
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "firebase": "^12.11.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "firebase-tools": "^15.25.1",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.8",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}

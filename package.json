{
  "name": "notedude2",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test \"mcp/keep/*.test.ts\" \"packages/ui/src/*.test.ts\" \"src/lib/*.test.ts\"",
    "build:ui": "npm run build --workspace @notedude/ui",
    "predev": "npm run build:ui",
    "dev": "next dev --webpack",
    "dev:emulator": "npm run build:ui && NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true next dev --webpack",
    "prebuild": "npm run build:ui",
    "build": "next build --webpack",
    "deploy": "npm run build && firebase deploy -P production --only hosting",
    "deploy:staging": "NEXT_PUBLIC_APP_ENV=staging npm run build && firebase deploy -P staging --only hosting,firestore,storage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appsciences/notedude2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/appsciences/notedude2/issues"
  },
  "homepage": "https://github.com/appsciences/notedude2#readme",
  "description": "",
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@sentry/nextjs": "^11.4.0",
    "firebase": "^12.11.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "postcss": "^8.5.8",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}

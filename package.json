{
  "name": "notedude2",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "playwright test",
    "build:ui": "npm run build --workspace @notedude/ui",
    "predev": "npm run build:ui",
    "dev": "next dev --webpack",
    "dev:todude": "NEXT_PUBLIC_APP_VARIANT=todude npm run dev",
    "prebuild": "npm run build:ui",
    "build": "next build --webpack",
    "prebuild:todude": "npm run build:ui",
    "build:todude": "NEXT_PUBLIC_APP_VARIANT=todude next build --webpack",
    "deploy": "npm run build && firebase deploy --only hosting:notedude",
    "deploy:todude": "npm run build:todude && firebase deploy --only hosting:todude",
    "deploy:staging": "npm run build && firebase hosting:channel:deploy staging --expires 30d --only notedude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appsciences/notedude2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/appsciences/notedude2/issues"
  },
  "homepage": "https://github.com/appsciences/notedude2#readme",
  "description": "",
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "firebase": "^12.11.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "postcss": "^8.5.8",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
